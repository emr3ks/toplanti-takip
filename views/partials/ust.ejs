<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= sayfaBaslik || 'Toplantı Takip' %> · Toplantı Takip</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<div class="uygulama">
  <aside class="kenar" aria-label="Ana menü">
    <a class="marka" href="/">
      <span class="marka-ikon">TT</span>
      <span>
        <strong>Toplantı Takip</strong>
        <small>Notlar · İşler · Raporlar</small>
      </span>
    </a>

    <nav>
      <a href="/" class="<%= aktifSayfa === 'genel-bakis' ? 'aktif' : '' %>" <%= aktifSayfa === 'genel-bakis' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
        </svg>
        Genel Bakış
      </a>
      <a href="/toplantilar" class="<%= aktifSayfa === 'toplantilar' ? 'aktif' : '' %>" <%= aktifSayfa === 'toplantilar' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="3"></rect>
          <path d="M8 3v4M16 3v4M3 11h18"></path>
        </svg>
        Toplantılar
      </a>
      <a href="/isler" class="<%= aktifSayfa === 'isler' ? 'aktif' : '' %>" <%= aktifSayfa === 'isler' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 11l3 3L22 4"></path>
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
        </svg>
        İşler
      </a>
      <a href="/sorumlular" class="<%= aktifSayfa === 'sorumlular' ? 'aktif' : '' %>" <%= aktifSayfa === 'sorumlular' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
        Sorumlular
      </a>
      <a href="/emailler" class="<%= aktifSayfa === 'emailler' ? 'aktif' : '' %>" <%= aktifSayfa === 'emailler' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="3"></rect>
          <path d="m22 7-10 6L2 7"></path>
        </svg>
        E-postalar
      </a>
      <a href="/ayarlar" class="<%= aktifSayfa === 'ayarlar' ? 'aktif' : '' %>" <%= aktifSayfa === 'ayarlar' ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        Ayarlar
      </a>
    </nav>

    <div class="kenar-alt">
      <div class="bugun"><%= bugunTr %></div>
      <span class="mod-rozet <%= testModu ? '' : 'canli' %>">
        <%= testModu ? 'Test modu' : 'SMTP aktif' %>
      </span>
    </div>
  </aside>
  <div class="kenar-karartma" data-menu-kapat></div>

  <main class="icerik">
    <header class="ustbar">
      <button class="menu-dugme" type="button" aria-label="Menüyü aç">☰</button>
      <div class="ust-yol">
        <span>Toplantı Takip</span>
        <span class="ayirici"></span>
        <strong><%= sayfaBaslik || (SAYFA_ADLARI[aktifSayfa] || 'Genel Bakış') %></strong>
      </div>
      <div class="ust-sag">
        <span class="tarih-rozet">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="16" rx="3"></rect>
            <path d="M8 3v4M16 3v4M3 11h18"></path>
          </svg>
          <%= bugunTr %>
        </span>
        <% if (testModu) { %>
          <span class="rozet rozet-test">Test modu</span>
        <% } %>
      </div>
    </header>

    <div class="sayfa">
