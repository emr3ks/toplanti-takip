<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= sayfaBaslik || 'Dashboard' %> · <%= sirket ? sirket.ad : 'Kalite Yönetim Sistemi' %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/egitim.css">
  <link rel="stylesheet" href="/raporlar.css">
  <link rel="stylesheet" href="/dof.css">
  <link rel="stylesheet" href="/tetkik.css">
</head>
<body>
<div class="uygulama">
  <aside class="kenar" aria-label="Ana menü">
    <a class="marka" href="/">
      <% if (sirket && sirket.logo) { %>
        <span class="marka-logo"><img src="/sirket-logo" alt="<%= sirket.ad %>"></span>
      <% } else { %>
        <span class="marka-ikon"><%= sirketBasHarfleri || 'QD' %></span>
      <% } %>
      <span class="marka-metin">
        <strong><%= sirket ? sirket.ad : 'Kalite Yönetim Sistemi' %></strong>
        <small>Quality Management System · Faz 5</small>
      </span>
    </a>

    <nav class="kenar-menu" aria-label="Modüller">
      <div class="menu-grup">
        <span class="menu-baslik">Genel</span>
        <a class="menu-link <%= aktifSayfa === 'dashboard' ? 'aktif' : '' %>" href="/" <%= aktifSayfa === 'dashboard' ? 'aria-current="page"' : '' %>>
          <span class="menu-ikon"><%- include('ikon', { ad: 'dashboard' }) %></span>
          <span>Dashboard</span>
          <% if (okunmamisBildirim) { %><span class="menu-rozet"><%= okunmamisBildirim > 99 ? '99+' : okunmamisBildirim %></span><% } %>
        </a>
        <a class="menu-link <%= aktifSayfa === 'dokumanlar' && !aktifTur ? 'aktif' : '' %>" href="/dokumanlar">
          <span class="menu-ikon"><%- include('ikon', { ad: 'dokuman' }) %></span>
          <span>Doküman Yönetimi</span>
          <% if (okunmamisDokuman) { %><span class="menu-rozet uyari"><%= okunmamisDokuman %></span><% } %>
        </a>

        <div class="alt-menu" aria-label="Doküman türleri">
          <% const turler = [['PR', 'Prosedürler'], ['TL', 'Talimatlar'], ['EK', 'El Kitabı'], ['LS', 'Listeler'], ['FR', 'Formlar']]; %>
          <% turler.forEach(function ([kod, ad]) { %>
            <a class="alt-link <%= aktifSayfa === 'dokumanlar' && aktifTur === kod ? 'aktif' : '' %>" href="/dokumanlar?tur=<%= kod %>">
              <span class="tur-nokta" style="background: <%= DOKUMAN_TURLERI[kod].renk %>"></span><%= ad %>
            </a>
          <% }) %>
        </div>

        <% if (yetkiliMi('dokuman.olustur')) { %>
          <a class="menu-link menu-cta <%= aktifSayfa === 'dokuman-yeni' ? 'aktif' : '' %>" href="/dokumanlar/yeni">
            <span class="menu-ikon"><%- include('ikon', { ad: 'yeni' }) %></span>
            <span>Yeni Doküman</span>
          </a>
        <% } %>
      </div>

      <% if (yetkiliMi('sablon')) { %>
        <div class="menu-grup">
          <span class="menu-baslik">Tasarım</span>
          <a class="menu-link <%= aktifSayfa === 'sablonlar' ? 'aktif' : '' %>" href="/sablonlar">
            <span class="menu-ikon"><%- include('ikon', { ad: 'sablon' }) %></span>
            <span>Doküman Şablon Tasarımcısı</span>
          </a>
        </div>
      <% } %>

      <div class="menu-grup">
        <span class="menu-baslik">Gelişim</span>
        <a class="menu-link <%= aktifSayfa === 'egitim' ? 'aktif' : '' %>" href="/egitim">
          <span class="menu-ikon"><%- include('ikon', { ad: 'egitim' }) %></span>
          <span>Eğitim Yönetimi</span>
        </a>
        <a class="menu-link <%= aktifSayfa === 'egitim-personel' ? 'aktif' : '' %>" href="/egitim/personel">
          <span class="menu-ikon"><%- include('ikon', { ad: 'organizasyon' }) %></span>
          <span>Personel Eğitim Sicili</span>
        </a>
      </div>

      <div class="menu-grup">
        <span class="menu-baslik">Kalite</span>
        <a class="menu-link <%= aktifSayfa === 'dof' ? 'aktif' : '' %>" href="/dof" <%= aktifSayfa === 'dof' ? 'aria-current="page"' : '' %>>
          <span class="menu-ikon"><%- include('ikon', { ad: 'dof' }) %></span>
          <span>DÖF Yönetimi</span>
        </a>
        <a class="menu-link <%= ['tetkik', 'tetkik-yeni', 'tetkik-detay', 'tetkik-takvim', 'tetkik-checklistler'].includes(aktifSayfa) ? 'aktif' : '' %>" href="/tetkik" <%= aktifSayfa === 'tetkik' ? 'aria-current="page"' : '' %>>
          <span class="menu-ikon"><%- include('ikon', { ad: 'tetkik' }) %></span>
          <span>İç Tetkik Yönetimi</span>
        </a>
      </div>

      <% if (yetkiliMi('rapor')) { %>
        <div class="menu-grup">
          <span class="menu-baslik">Raporlar</span>
          <a class="menu-link <%= aktifSayfa === 'raporlar' ? 'aktif' : '' %>" href="/raporlar">
            <span class="menu-ikon"><%- include('ikon', { ad: 'dokuman' }) %></span>
            <span>Kurumsal Raporlar</span>
          </a>
        </div>
      <% } %>

      <div class="menu-grup">
        <span class="menu-baslik">Kurumsal</span>
        <a class="menu-link <%= aktifSayfa === 'organizasyon' ? 'aktif' : '' %>" href="/organizasyon">
          <span class="menu-ikon"><%- include('ikon', { ad: 'organizasyon' }) %></span>
          <span>Organizasyon ve Kullanıcılar</span>
        </a>
        <% if (yetkiliMi('sistem')) { %>
          <a class="menu-link <%= aktifSayfa === 'ayarlar' ? 'aktif' : '' %>" href="/ayarlar">
            <span class="menu-ikon"><%- include('ikon', { ad: 'ayarlar' }) %></span>
            <span>Sistem Ayarları</span>
          </a>
          <a class="menu-link <%= aktifSayfa === 'emailler' ? 'aktif' : '' %>" href="/emailler">
            <span class="menu-ikon"><%- include('ikon', { ad: 'mail' }) %></span>
            <span>E-posta Günlüğü</span>
          </a>
        <% } %>
      </div>
    </nav>

    <div class="kenar-alt">
      <div class="kenar-kullanici">
        <span class="avatar"><%= basHarfler(kullanici ? kullanici.ad : '') %></span>
        <span class="kenar-kullanici-bilgi">
          <strong><%= kullanici ? kullanici.ad : 'Misafir' %></strong>
          <small><%= kullanici ? rolEtiketi(kullanici.rol) : '' %><%= kullanici && kullanici.departman_ad ? ' · ' + kullanici.departman_ad : '' %></small>
        </span>
        <form method="post" action="/cikis" title="Oturumu kapat">
          <button class="cikis-dugme" type="submit" aria-label="Oturumu kapat"><%- include('ikon', { ad: 'cikis' }) %></button>
        </form>
      </div>
      <div class="kenar-mini">
        <span><%= bugunTr %></span>
        <span class="mod-rozet <%= testModu ? '' : 'canli' %>"><%= testModu ? 'Test modu' : 'SMTP aktif' %></span>
      </div>
    </div>
  </aside>
  <div class="kenar-karartma" data-menu-kapat></div>

  <main class="icerik">
    <header class="ustbar">
      <button class="menu-dugme" type="button" aria-label="Menüyü aç">☰</button>
      <div class="ust-yol">
        <span>QDMS</span>
        <span class="ayirici"></span>
        <strong><%= sayfaBaslik || (SAYFA_ADLARI[aktifSayfa] || 'Dashboard') %></strong>
      </div>
      <div class="ust-sag">
        <a class="bildirim-dugme" href="/#bildirimler" aria-label="Bildirimler" title="Bildirimler">
          <%- include('ikon', { ad: 'zil' }) %>
          <% if (okunmamisBildirim) { %><span class="bildirim-sayi"><%= okunmamisBildirim > 99 ? '99+' : okunmamisBildirim %></span><% } %>
        </a>
        <span class="tarih-rozet"><%= bugunTr %></span>
        <a class="kullanici-cip" href="/organizasyon">
          <span class="avatar"><%= basHarfler(kullanici ? kullanici.ad : '') %></span>
          <span class="kullanici-cip-metin">
            <strong><%= kullanici ? kullanici.ad : '' %></strong>
            <small><%= kullanici ? rolEtiketi(kullanici.rol) : '' %></small>
          </span>
        </a>
      </div>
    </header>

    <div class="sayfa">
      <%- include('bildirim') %>
