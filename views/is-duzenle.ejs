<%- include('partials/ust', { aktifSayfa: 'isler' }) %>

<div class="sayfa-bas">
  <div>
    <h1>İşi Düzenle</h1>
    <p><%= is.toplanti_ad %> · <%= tarihTr(is.toplanti_tarih) %></p>
  </div>
  <div class="sayfa-eylem">
    <a class="btn btn-hayalet" href="<%= donus %>">← Geri Dön</a>
  </div>
</div>

<%- include('partials/bildirim') %>

<% if (typeof hata !== 'undefined' && hata) { %>
  <div class="bildirim bildirim-hata" role="alert">
    <span class="bildirim-ikon">!</span>
    <div><%= hata %></div>
  </div>
<% } %>

<div class="iki-kolon">
  <div class="kart">
    <div class="kart-bas">
      <div>
        <h2>İş Bilgileri</h2>
        <p>Başlık, sorumlu, hedef tarih, not ve durum bilgilerini güncelleyin.</p>
      </div>
      <span class="rozet rozet-<%= is.durum %>"><%= durumEtiketi(is.durum) %></span>
    </div>

    <form method="post" action="/isler/<%= is.id %>" class="form-grid">
      <input type="hidden" name="donus" value="<%= donus %>">

      <div class="alan tam">
        <label for="is-baslik">İş başlığı</label>
        <input class="girdi" type="text" id="is-baslik" name="baslik" value="<%= form.baslik %>" maxlength="200" required>
      </div>

      <div class="alan">
        <label for="is-sorumlu">Sorumlu kişi</label>
        <select id="is-sorumlu" name="sorumlu_id">
          <option value="">Atanmadı</option>
          <% sorumlular.forEach(function (sorumlu) { %>
            <option value="<%= sorumlu.id %>" <%= Number(form.sorumlu_id) === sorumlu.id ? 'selected' : '' %>><%= sorumlu.ad %> (<%= sorumlu.email %>)</option>
          <% }) %>
        </select>
      </div>

      <div class="alan">
        <label for="is-hedef">Hedef tarih</label>
        <input class="girdi" type="date" id="is-hedef" name="hedef_tarih" value="<%= form.hedef_tarih || '' %>">
        <span class="ipucu">Hedef tarih değiştirilirse hatırlatma durumu sıfırlanır.</span>
      </div>

      <div class="alan">
        <label for="is-durum">Durum</label>
        <select id="is-durum" name="durum">
          <option value="aktif" <%= form.durum === 'aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="beklemede" <%= form.durum === 'beklemede' ? 'selected' : '' %>>Beklemede</option>
          <option value="tamamlandi" <%= form.durum === 'tamamlandi' ? 'selected' : '' %>>Tamamlandı</option>
        </select>
      </div>

      <div class="alan">
        <label>Toplantı</label>
        <input class="girdi" type="text" value="<%= is.toplanti_ad %>" disabled>
        <span class="ipucu">İşin bağlı olduğu toplantı değiştirilemez.</span>
      </div>

      <div class="alan tam">
        <label for="is-not">Toplantı notu</label>
        <textarea id="is-not" name="not_metni" maxlength="5000" rows="6"><%= form.not_metni %></textarea>
      </div>

      <div class="alan tam">
        <div class="form-eylem">
          <button class="btn btn-birincil" type="submit">Değişiklikleri Kaydet</button>
          <a class="btn btn-hayalet" href="<%= donus %>">Vazgeç</a>
        </div>
      </div>
    </form>
  </div>

  <div class="dikey">
    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Kayıt Bilgileri</h2>
          <p>Oluşturulma ve güncelleme zamanları.</p>
        </div>
      </div>
      <div class="bilgi-kutu">
        <strong>Oluşturulma:</strong> <%= zamanTr(is.olusturma_tarihi) %><br>
        <strong>Güncellenme:</strong> <%= zamanTr(is.guncelleme_tarihi) %><br>
        <% if (is.tamamlanma_tarihi) { %>
          <strong>Tamamlanma:</strong> <%= zamanTr(is.tamamlanma_tarihi) %><br>
        <% } %>
        <strong>Hatırlatma:</strong>
        <%= is.hatirlatma_gonderildi ? 'Gönderildi' : 'Henüz gönderilmedi' %>
        <% if (is.hatirlatma_gonderildi && is.hatirlatma_tarihi) { %>
          (<%= zamanTr(is.hatirlatma_tarihi) %>)
        <% } %>
      </div>

      <div class="eylem-grubu" style="margin-top:14px;">
        <a class="btn btn-ikincil" href="/toplantilar/<%= is.toplanti_id %>">Toplantıya Git</a>
        <a class="btn btn-hayalet" href="/isler?toplanti=<%= is.toplanti_id %>">Tüm İşleri Gör</a>
      </div>
    </div>

    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>İşi Sil</h2>
          <p>Bu iş kalıcı olarak silinir.</p>
        </div>
      </div>
      <form method="post" action="/isler/<%= is.id %>/sil" data-onay="Bu iş kalıcı olarak silinecek. Emin misiniz?">
        <input type="hidden" name="donus" value="<%= donus %>">
        <button class="btn btn-tehlike btn-blok" type="submit">İşi Sil</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/alt') %>
