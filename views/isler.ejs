<%- include('partials/ust', { aktifSayfa: 'isler' }) %>

<div class="sayfa-bas">
  <div>
    <h1>İşler</h1>
    <p>Tüm toplantılardaki işleri filtreleyin, durumlarını değiştirin ve hedef tarihlerini takip edin.</p>
  </div>
  <div class="sayfa-eylem">
    <a class="btn btn-hayalet" href="/isler?durum=beklemede">Beklemede (<%= durumSayilari.beklemede %>)</a>
    <a class="btn btn-hayalet" href="/isler?durum=aktif">Aktif (<%= durumSayilari.aktif %>)</a>
    <a class="btn btn-birincil" href="/toplantilar">+ Toplantıdan İş Ekle</a>
  </div>
</div>

<%- include('partials/bildirim') %>

<section class="kart">
  <div class="kart-bas">
    <div>
      <h2>Filtrele</h2>
      <p>Durum, toplantı, sorumlu veya metin ile arayın.</p>
    </div>
    <span class="cip"><%= sonucSayisi %> sonuç</span>
  </div>
  <form method="get" action="/isler" class="form-grid" data-otomatik-gonder>
    <div class="alan">
      <label for="filtre-durum">Durum</label>
      <select id="filtre-durum" name="durum">
        <option value="hepsi" <%= filtreler.durum === 'hepsi' ? 'selected' : '' %>>Tüm durumlar</option>
        <option value="aktif" <%= filtreler.durum === 'aktif' ? 'selected' : '' %>>Aktif (<%= durumSayilari.aktif %>)</option>
        <option value="beklemede" <%= filtreler.durum === 'beklemede' ? 'selected' : '' %>>Beklemede (<%= durumSayilari.beklemede %>)</option>
        <option value="tamamlandi" <%= filtreler.durum === 'tamamlandi' ? 'selected' : '' %>>Tamamlandı (<%= durumSayilari.tamamlandi %>)</option>
      </select>
    </div>
    <div class="alan">
      <label for="filtre-toplanti">Toplantı</label>
      <select id="filtre-toplanti" name="toplanti">
        <option value="">Tüm toplantılar</option>
        <% toplantilar.forEach(function (toplanti) { %>
          <option value="<%= toplanti.id %>" <%= Number(filtreler.toplanti) === toplanti.id ? 'selected' : '' %>><%= toplanti.ad %></option>
        <% }) %>
      </select>
    </div>
    <div class="alan">
      <label for="filtre-sorumlu">Sorumlu</label>
      <select id="filtre-sorumlu" name="sorumlu">
        <option value="">Tüm sorumlular</option>
        <% sorumlular.forEach(function (sorumlu) { %>
          <option value="<%= sorumlu.id %>" <%= Number(filtreler.sorumlu) === sorumlu.id ? 'selected' : '' %>><%= sorumlu.ad %></option>
        <% }) %>
      </select>
    </div>
    <div class="alan">
      <label for="filtre-arama">Arama</label>
      <input class="girdi" type="search" id="filtre-arama" name="q" value="<%= filtreler.q %>" placeholder="Başlık, not, toplantı veya sorumlu">
    </div>
    <div class="alan tam eylem-grubu">
      <button class="btn btn-birincil" type="submit">Filtrele</button>
      <a class="btn btn-hayalet" href="/isler">Filtreleri Temizle</a>
    </div>
  </form>
</section>

<div class="iki-kolon" style="margin-top:18px;">
  <div class="kart">
    <div class="kart-bas">
      <div>
        <h2>İş Listesi</h2>
        <p><%= sonucSayisi %> iş gösteriliyor. En fazla 400 kayıt listelenir.</p>
      </div>
    </div>

    <% if (isler.length) { %>
      <div class="is-listesi">
        <% isler.forEach(function (is) { %>
          <%- include('partials/is-satiri', { is: is, donus: tamYol, toplantiGoster: true }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bos">
        <div class="bos-ikon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
        </div>
        <h3>Sonuç bulunamadı</h3>
        <p>Filtreleri temizleyin veya bir toplantıya yeni iş ekleyin.</p>
        <a class="btn btn-ikincil" href="/isler">Filtreleri Temizle</a>
      </div>
    <% } %>
  </div>

  <div class="dikey">
    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Yeni İş Ekle</h2>
          <p>Bir toplantı seçerek yeni iş oluşturun.</p>
        </div>
      </div>

      <% if (toplantilar.length) { %>
        <form method="post" action="/isler" class="dikey">
          <input type="hidden" name="donus" value="/isler">
          <input type="hidden" name="durum" value="aktif">

          <div class="alan">
            <label for="yeni-toplanti">Toplantı</label>
            <select id="yeni-toplanti" name="toplanti_id" required>
              <% toplantilar.forEach(function (toplanti) { %>
                <option value="<%= toplanti.id %>"><%= toplanti.ad %> · <%= tarihTr(toplanti.tarih) %></option>
              <% }) %>
            </select>
          </div>
          <div class="alan">
            <label for="yeni-baslik">İş başlığı</label>
            <input class="girdi" type="text" id="yeni-baslik" name="baslik" placeholder="Yapılacak iş" maxlength="200" required>
          </div>
          <div class="alan">
            <label for="yeni-sorumlu">Sorumlu kişi</label>
            <select id="yeni-sorumlu" name="sorumlu_id">
              <option value="">Atanmadı</option>
              <% sorumlular.forEach(function (sorumlu) { %>
                <option value="<%= sorumlu.id %>"><%= sorumlu.ad %></option>
              <% }) %>
            </select>
          </div>
          <div class="alan">
            <label for="yeni-hedef">Hedef tarih</label>
            <input class="girdi" type="date" id="yeni-hedef" name="hedef_tarih">
          </div>
          <div class="alan">
            <label for="yeni-not">Toplantı notu</label>
            <textarea id="yeni-not" name="not_metni" placeholder="Not, karar veya bağlam..." maxlength="5000"></textarea>
          </div>
          <button class="btn btn-birincil btn-blok" type="submit">+ İş Ekle</button>
        </form>
      <% } else { %>
        <div class="bos" style="padding:24px 8px;">
          <h3>Önce toplantı oluşturun</h3>
          <p>İş eklemek için en az bir toplantı gerekir.</p>
          <a class="btn btn-birincil" href="/toplantilar#yeni-toplanti">+ Yeni Toplantı</a>
        </div>
      <% } %>
    </div>

    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Durum Özeti</h2>
          <p>Tüm toplantılardaki iş dağılımı.</p>
        </div>
      </div>
      <div class="dikey">
        <div class="sorumlu-satir">
          <span class="rozet rozet-aktif">Aktif</span>
          <span class="sorumlu-bilgi"><strong><%= durumSayilari.aktif %></strong><span>Devam eden iş</span></span>
        </div>
        <div class="sorumlu-satir">
          <span class="rozet rozet-beklemede">Beklemede</span>
          <span class="sorumlu-bilgi"><strong><%= durumSayilari.beklemede %></strong><span>Beklemeye alınan iş</span></span>
        </div>
        <div class="sorumlu-satir">
          <span class="rozet rozet-tamamlandi">Tamamlandı</span>
          <span class="sorumlu-bilgi"><strong><%= durumSayilari.tamamlandi %></strong><span>Tamamlanan iş</span></span>
        </div>
      </div>
      <a class="btn btn-ikincil btn-blok" href="/isler?durum=beklemede" style="margin-top:12px;">Bekleyen İşleri Aç</a>
    </div>
  </div>
</div>

<%- include('partials/alt') %>
