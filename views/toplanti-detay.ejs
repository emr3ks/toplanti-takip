<%- include('partials/ust', { aktifSayfa: 'toplantilar' }) %>

<section class="toplanti-hero">
  <div>
    <div class="alt">
      <span class="rozet rozet-<%= toplanti.durum %>"><%= TOPLANTI_DURUMLARI[toplanti.durum] %></span>
      <span><%= tarihTr(toplanti.tarih) %></span>
      <span><%= toplanti.is_sayisi %> iş</span>
      <% if (toplanti.durum === 'tamamlandi' && toplanti.tamamlanma_tarihi) { %>
        <span>Tamamlandı: <%= zamanTr(toplanti.tamamlanma_tarihi) %></span>
      <% } %>
    </div>
    <h1><%= toplanti.ad %></h1>
    <div class="ozet-serit">
      <span><strong><%= toplanti.aktif_sayisi %></strong> aktif</span>
      <span><strong><%= toplanti.beklemede_sayisi %></strong> beklemede</span>
      <span><strong><%= toplanti.tamamlandi_sayisi %></strong> tamamlandı</span>
      <span><strong>%<%= ilerleme %></strong> ilerleme</span>
      <% if (sonRapor) { %>
        <span>Son rapor: <%= zamanTr(sonRapor.olusturma_tarihi) %></span>
      <% } %>
    </div>
  </div>
  <div class="eylem">
    <% if (toplanti.durum === 'acik') { %>
      <form method="post" action="/toplantilar/<%= toplanti.id %>/tamamla" data-onay="Toplantı tamamlanacak ve rapor e-posta ile gönderilecek. Devam edilsin mi?">
        <button class="btn btn-beyaz" type="submit">Toplantıyı Tamamla ve Rapor Gönder</button>
      </form>
    <% } else { %>
      <form method="post" action="/toplantilar/<%= toplanti.id %>/rapor">
        <button class="btn btn-beyaz" type="submit">Raporu Tekrar Gönder</button>
      </form>
      <form method="post" action="/toplantilar/<%= toplanti.id %>/yeniden-ac" data-onay="Toplantı yeniden açılacak. Devam edilsin mi?">
        <button class="btn btn-hayalet" type="submit">Yeniden Aç</button>
      </form>
    <% } %>
  </div>
</section>

<%- include('partials/bildirim') %>

<% if (!ayarlar.raporAlici) { %>
  <div class="bilgi-kutu" style="margin-bottom:18px;border-color:#fcd34d;background:#fffbeb;color:#92400e;">
    <strong>Rapor alıcısı tanımlı değil.</strong> Toplantı raporunun gönderilebilmesi için
    <a href="/ayarlar">Ayarlar → Rapor alıcı e-postası</a> alanını doldurun.
  </div>
<% } %>

<div class="iki-kolon">
  <div class="kart">
    <div class="kart-bas">
      <div>
        <h2>İşler</h2>
        <p>Durum değiştirmek için iş kartlarındaki kısayol düğmelerini kullanabilirsiniz.</p>
      </div>
      <a class="btn btn-kucuk btn-hayalet" href="/isler?toplanti=<%= toplanti.id %>">Tüm İşlerde Aç</a>
    </div>

    <div class="sekmeler">
      <a class="sekme <%= durum === 'hepsi' ? 'aktif' : '' %>" href="/toplantilar/<%= toplanti.id %>">
        Tümü <span class="sayi"><%= toplanti.is_sayisi %></span>
      </a>
      <a class="sekme <%= durum === 'aktif' ? 'aktif' : '' %>" href="/toplantilar/<%= toplanti.id %>?durum=aktif">
        Aktif <span class="sayi"><%= toplanti.aktif_sayisi %></span>
      </a>
      <a class="sekme <%= durum === 'beklemede' ? 'aktif' : '' %>" href="/toplantilar/<%= toplanti.id %>?durum=beklemede">
        Beklemede <span class="sayi"><%= toplanti.beklemede_sayisi %></span>
      </a>
      <a class="sekme <%= durum === 'tamamlandi' ? 'aktif' : '' %>" href="/toplantilar/<%= toplanti.id %>?durum=tamamlandi">
        Tamamlandı <span class="sayi"><%= toplanti.tamamlandi_sayisi %></span>
      </a>
    </div>

    <% if (isler.length) { %>
      <div class="is-listesi">
        <% isler.forEach(function (is) { %>
          <%- include('partials/is-satiri', { is: is, donus: tamYol, toplantiGoster: false }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bos">
        <div class="bos-ikon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
        </div>
        <% if (toplanti.is_sayisi === 0) { %>
          <h3>Bu toplantıya henüz iş eklenmedi</h3>
          <p>Sağdaki formu kullanarak ilk işi ekleyin; sorumlu ve hedef tarih atayabilirsiniz.</p>
        <% } else { %>
          <h3>Bu filtrede iş yok</h3>
          <p>Seçili durumda iş bulunmuyor. Tüm işleri görmek için “Tümü” sekmesine dönün.</p>
          <a class="btn btn-ikincil" href="/toplantilar/<%= toplanti.id %>">Tümünü Göster</a>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="dikey">
    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Yeni İş Ekle</h2>
          <p>Bu toplantıya bağlı yeni bir iş oluşturun.</p>
        </div>
      </div>
      <form method="post" action="/isler" class="dikey">
        <input type="hidden" name="toplanti_id" value="<%= toplanti.id %>">
        <input type="hidden" name="donus" value="/toplantilar/<%= toplanti.id %>">
        <input type="hidden" name="durum" value="aktif">

        <div class="alan">
          <label for="yeni-baslik">İş başlığı</label>
          <input class="girdi" type="text" id="yeni-baslik" name="baslik" placeholder="Örn. Landing page metinlerini güncelle" maxlength="200" required>
        </div>
        <div class="alan">
          <label for="yeni-sorumlu">Sorumlu kişi</label>
          <select id="yeni-sorumlu" name="sorumlu_id">
            <option value="">Atanmadı</option>
            <% sorumlular.forEach(function (sorumlu) { %>
              <option value="<%= sorumlu.id %>"><%= sorumlu.ad %></option>
            <% }) %>
          </select>
          <% if (!sorumlular.length) { %>
            <span class="ipucu">Henüz sorumlu yok. <a href="/sorumlular">Sorumlu ekleyin</a>.</span>
          <% } %>
        </div>
        <div class="alan">
          <label for="yeni-hedef">Hedef tarih</label>
          <input class="girdi" type="date" id="yeni-hedef" name="hedef_tarih">
          <span class="ipucu">Hatırlatma e-postası hedef tarihinden 1 gün önce gönderilir.</span>
        </div>
        <div class="alan">
          <label for="yeni-not">Toplantı notu</label>
          <textarea id="yeni-not" name="not_metni" placeholder="Karar, bağlam veya yapılacaklar..." maxlength="5000"></textarea>
        </div>
        <button class="btn btn-birincil btn-blok" type="submit">+ İş Ekle</button>
      </form>
    </div>

    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Toplantı Bilgileri</h2>
          <p>Kayıt ayrıntıları ve düzenleme.</p>
        </div>
      </div>
      <div class="bilgi-kutu">
        <strong>Ad:</strong> <%= toplanti.ad %><br>
        <strong>Tarih:</strong> <%= tarihTr(toplanti.tarih) %><br>
        <strong>Durum:</strong> <%= TOPLANTI_DURUMLARI[toplanti.durum] %><br>
        <strong>Oluşturulma:</strong> <%= zamanTr(toplanti.olusturma_tarihi) %>
        <% if (sonRapor) { %>
          <br><strong>Son rapor:</strong> <%= zamanTr(sonRapor.olusturma_tarihi) %>
          (<%= EPOSTA_DURUMLARI[sonRapor.durum] || sonRapor.durum %>)
        <% } %>
      </div>

      <div style="margin-top:14px;">
        <details class="duzenle">
          <summary>Toplantı bilgilerini düzenle</summary>
          <form class="duzenle-form form-grid" method="post" action="/toplantilar/<%= toplanti.id %>">
            <div class="alan">
              <label for="duzenle-ad">Toplantı adı</label>
              <input class="girdi" type="text" id="duzenle-ad" name="ad" value="<%= toplanti.ad %>" maxlength="150" required>
            </div>
            <div class="alan">
              <label for="duzenle-tarih">Tarih</label>
              <input class="girdi" type="date" id="duzenle-tarih" name="tarih" value="<%= toplanti.tarih %>" required>
            </div>
            <div class="alan tam">
              <button class="btn btn-ikincil" type="submit">Bilgileri Kaydet</button>
            </div>
          </form>
        </details>

        <details class="duzenle" style="margin-top:12px;">
          <summary>Toplantıyı sil</summary>
          <form class="duzenle-form" method="post" action="/toplantilar/<%= toplanti.id %>/sil" data-onay="Toplantı ve bağlı tüm işleri kalıcı olarak silinecek. Emin misiniz?">
            <p class="metin-kucuk metin-soluk" style="margin:0 0 10px;">Toplantıya bağlı tüm işler de silinir. Bu işlem geri alınamaz.</p>
            <button class="btn btn-tehlike" type="submit">Toplantıyı Sil</button>
          </form>
        </details>
      </div>
    </div>
  </div>
</div>

<%- include('partials/alt') %>
