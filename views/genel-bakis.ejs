<%- include('partials/ust', { aktifSayfa: 'genel-bakis' }) %>

<div class="sayfa-bas">
  <div>
    <h1>Genel Bakış</h1>
    <p>Toplantılarınıza, işlerinize ve yaklaşan hedeflere tek ekrandan göz atın.</p>
  </div>
  <div class="sayfa-eylem">
    <a class="btn btn-hayalet" href="/isler?durum=beklemede">Bekleyen İşler</a>
    <a class="btn btn-birincil" href="/toplantilar#yeni-toplanti">+ Yeni Toplantı</a>
  </div>
</div>

<%- include('partials/bildirim') %>

<section class="hero">
  <h1>Merhaba, bugünün planına göz atın.</h1>
  <p><%= bugunTr %> · <%= sayilar.acik_toplanti %> açık toplantı, <%= sayilar.aktif %> aktif iş ve <%= sayilar.beklemede %> bekleyen iş bulunuyor.</p>
  <div class="hero-eylem">
    <a class="btn btn-beyaz" href="/toplantilar">Toplantılara Git</a>
    <a class="btn btn-beyaz" href="/isler" style="background:rgba(255,255,255,.14);color:#fff;box-shadow:inset 0 0 0 1px rgba(255,255,255,.24);">Tüm İşleri Gör</a>
  </div>
  <div class="hero-veri">
    <div><strong><%= sayilar.aktif %></strong><span>Aktif iş</span></div>
    <div><strong><%= geciken %></strong><span>Geciken</span></div>
    <div><strong><%= sayilar.tamamlandi %></strong><span>Tamamlandı</span></div>
    <div><strong><%= sayilar.sorumlu_sayisi %></strong><span>Sorumlu</span></div>
  </div>
</section>

<section class="istatistik-grid" aria-label="Özet sayılar">
  <div class="stat">
    <span class="stat-ikon">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="3"></rect>
        <path d="M8 3v4M16 3v4M3 11h18"></path>
      </svg>
    </span>
    <span class="stat-icerik">
      <strong><%= sayilar.acik_toplanti %></strong>
      <span>Açık toplantı</span>
    </span>
  </div>
  <div class="stat">
    <span class="stat-ikon yesil">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 11l3 3L22 4"></path>
        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
      </svg>
    </span>
    <span class="stat-icerik">
      <strong><%= sayilar.aktif %></strong>
      <span>Aktif iş<%= geciken ? ` · ${geciken} geciken` : '' %></span>
    </span>
  </div>
  <div class="stat">
    <span class="stat-ikon amber">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
    </span>
    <span class="stat-icerik">
      <strong><%= sayilar.beklemede %></strong>
      <span>Beklemede</span>
    </span>
  </div>
  <div class="stat">
    <span class="stat-ikon slate">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </span>
    <span class="stat-icerik">
      <strong><%= sayilar.tamamlandi %></strong>
      <span>Tamamlanan iş</span>
    </span>
  </div>
</section>

<div class="iki-kolon">
  <div class="kart">
    <div class="kart-bas">
      <div>
        <h2>Yaklaşan Hedefler</h2>
        <p>Aktif işler; hedef tarihi yaklaşanlar ve gecikenler en üstte.</p>
      </div>
      <a class="btn btn-kucuk btn-hayalet" href="/isler?durum=aktif">Tümünü Gör</a>
    </div>

    <% if (yaklasan.length) { %>
      <div class="is-listesi">
        <% yaklasan.forEach(function (is) { %>
          <%- include('partials/is-satiri', { is: is, donus: '/', toplantiGoster: true }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bos">
        <div class="bos-ikon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
        </div>
        <h3>Yaklaşan hedef yok</h3>
        <p>Bir toplantıya iş ekleyip hedef tarih belirlediğinizde burada görünecek.</p>
        <a class="btn btn-ikincil" href="/toplantilar">Toplantı Seç</a>
      </div>
    <% } %>
  </div>

  <div>
    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Son Toplantılar</h2>
          <p>En güncel toplantılar ve iş ilerlemeleri.</p>
        </div>
        <a class="btn btn-kucuk btn-hayalet" href="/toplantilar">Tümü</a>
      </div>

      <% if (sonToplantilar.length) { %>
        <% sonToplantilar.forEach(function (toplanti) { %>
          <a class="sorumlu-satir" href="/toplantilar/<%= toplanti.id %>" style="text-decoration:none;color:inherit;">
            <span class="avatar"><%= basHarfler(toplanti.ad) %></span>
            <span class="sorumlu-bilgi">
              <strong><%= toplanti.ad %></strong>
              <span><%= tarihTr(toplanti.tarih) %> · <%= toplanti.is_sayisi %> iş · <%= toplanti.tamamlandi_sayisi %> tamamlandı</span>
            </span>
            <span class="rozet rozet-<%= toplanti.durum %>"><%= TOPLANTI_DURUMLARI[toplanti.durum] %></span>
          </a>
        <% }) %>
      <% } else { %>
        <div class="bos" style="padding:24px 8px;">
          <h3>Henüz toplantı yok</h3>
          <p>İlk toplantınızı oluşturarak başlayın.</p>
          <a class="btn btn-birincil" href="/toplantilar#yeni-toplanti">+ Yeni Toplantı</a>
        </div>
      <% } %>
    </div>

    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>E-posta Durumu</h2>
          <p>Rapor ve hatırlatma altyapısının güncel durumu.</p>
        </div>
        <a class="btn btn-kucuk btn-hayalet" href="/ayarlar">Ayarlar</a>
      </div>
      <div class="dikey">
        <div class="bilgi-kutu">
          <strong>Gönderim modu:</strong>
          <%= mailModu === 'test' ? 'Test modu — e-postalar gönderilmez, data/outbox klasörüne ve E-posta Günlüğü sayfasına kaydedilir.' : 'SMTP üzerinden gerçek e-posta gönderimi etkin.' %>
        </div>
        <div class="bilgi-kutu">
          <strong>Günlük hatırlatma:</strong>
          Her gün <strong><%= ayarlar.hatirlatmaSaati %></strong> (<%= ayarlar.saatDilimi %>) saatinde çalışır.
        </div>
        <div class="bilgi-kutu">
          <strong>Rapor alıcısı:</strong>
          <%= ayarlar.raporAlici || 'Henüz tanımlanmadı. Toplantı raporu göndermek için Ayarlar bölümünü kullanın.' %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/alt') %>
