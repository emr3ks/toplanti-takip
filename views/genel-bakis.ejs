<%- include('partials/ust', { aktifSayfa: 'dashboard' }) %>

<div class="sayfa-bas">
  <div>
    <h1>Genel Bakış</h1>
    <p>Merhaba <%= kullanici.ad %>, kalite sisteminizin bugünkü durumuna ve size düşen işlere göz atın.</p>
  </div>
  <div class="sayfa-eylem">
    <% if (yetkiliMi('dokuman.olustur')) { %>
      <a class="btn btn-hayalet" href="/dokumanlar">Doküman Yönetimi</a>
      <a class="btn btn-birincil" href="/dokumanlar/yeni">+ Yeni Doküman</a>
    <% } else { %>
      <a class="btn btn-birincil" href="/dokumanlar">Dokümanlarım</a>
    <% } %>
  </div>
</div>

<section class="qdms-hero">
  <div class="qdms-hero-icerik">
    <span class="qdms-hero-rozet"><%= DOKUMAN_TURLERI.PR.ad %> · <%= DOKUMAN_TURLERI.TL.ad %> · <%= DOKUMAN_TURLERI.EK.ad %> · <%= DOKUMAN_TURLERI.LS.ad %> · <%= DOKUMAN_TURLERI.FR.ad %></span>
    <h2><%= kullanici.departman_ad ? kullanici.departman_ad + ' ekibinin ' : '' %>kalite gündemi</h2>
    <p><%= bugunTr %> · <%= dokumanSayilari.yayinda %> doküman yayında, <%= dokumanSayilari.kontrol %> doküman onay bekliyor ve size ait <%= okunmamisDokuman %> okunmamış doküman var.</p>
    <div class="qdms-hero-veri">
      <div><strong><%= dokumanSayilari.toplam %></strong><span>Görünen doküman</span></div>
      <div><strong><%= bekleyenOnay %></strong><span>Onay bekleyen</span></div>
      <div><strong><%= sayilar.kullanici_sayisi %></strong><span>Aktif kullanıcı</span></div>
      <div><strong><%= sayilar.departman_sayisi %></strong><span>Departman</span></div>
    </div>
  </div>
  <div class="qdms-hero-rozetler">
    <% if (onaylayabilir && bekleyenOnay) { %>
      <a class="hero-rozet-kart" href="/dokumanlar?durum=kontrol">
        <span class="hero-rozet-sayi"><%= bekleyenOnay %></span>
        <span>Bekleyen onayım</span>
      </a>
    <% } %>
    <% if (okunmamisDokuman) { %>
      <a class="hero-rozet-kart" href="/dokumanlar">
        <span class="hero-rozet-sayi"><%= okunmamisDokuman %></span>
        <span>Okunmamış dokümanım</span>
      </a>
    <% } %>
  </div>
</section>

<section class="istatistik-grid" aria-label="Özet sayılar">
  <div class="stat">
    <span class="stat-ikon amber"><%- include('partials/ikon', { ad: 'onay' }) %></span>
    <span class="stat-icerik">
      <strong><%= bekleyenOnay %></strong>
      <span>Bekleyen onayım</span>
    </span>
  </div>
  <div class="stat">
    <span class="stat-ikon"><%- include('partials/ikon', { ad: 'dokuman' }) %></span>
    <span class="stat-icerik">
      <strong><%= okunmamisDokuman %></strong>
      <span>Okunmamış dokümanım</span>
    </span>
  </div>
  <div class="stat">
    <span class="stat-ikon yesil"><%- include('partials/ikon', { ad: 'dokuman' }) %></span>
    <span class="stat-icerik">
      <strong><%= dokumanSayilari.yayinda %></strong>
      <span>Yayındaki doküman</span>
    </span>
  </div>
  <div class="stat">
    <span class="stat-ikon slate"><%- include('partials/ikon', { ad: 'isler' }) %></span>
    <span class="stat-icerik">
      <strong><%= sayilar.aktif %></strong>
      <span>Aktif iş<%= geciken ? ` · ${geciken} geciken` : '' %></span>
    </span>
  </div>
</section>

<div class="iki-kolon qdms-iki-kolon">
  <div>
    <% if (onaylayabilir) { %>
      <div class="kart" id="onaylar">
        <div class="kart-bas">
          <div>
            <h2>Bekleyen Onaylarım</h2>
            <p>Kontrol / onay bekleyen dokümanlar. Onayladığınızda PDF filigranı kalkar ve dağıtım başlar.</p>
          </div>
          <a class="btn btn-kucuk btn-hayalet" href="/dokumanlar?durum=kontrol">Tümü</a>
        </div>
        <% if (onayBekleyenler.length) { %>
          <div class="belge-listesi">
            <% onayBekleyenler.forEach(function (belge) { %>
              <a class="belge-satiri" href="/dokumanlar/<%= belge.id %>">
                <span class="belge-kod"><%= belge.kod %></span>
                <span class="belge-satir-govde">
                  <strong><%= belge.baslik %></strong>
                  <span><%= belge.tur_ad %> · <%= revizyonEtiketi(belge.revizyon) %> · <%= belge.hazirlayan_ad || '—' %></span>
                </span>
                <span class="rozet rozet-dok-<%= dokumanDurumSinifi(belge.durum) %>"><%= dokumanDurumEtiketi(belge.durum) %></span>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="bos" style="padding:24px 12px;">
            <h3>Bekleyen onay yok</h3>
            <p>Onaya gönderilen dokümanlar burada listelenir.</p>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="kart" id="okunacaklar">
      <div class="kart-bas">
        <div>
          <h2>Okunmamış Dokümanlarım</h2>
          <p>Tarafınıza dağıtılan ve “Okudum, Anladım” onayı bekleyen dokümanlar.</p>
        </div>
        <span class="rozet rozet-okunmamis"><%= okunacaklar.length %> bekliyor</span>
      </div>
      <% if (okunacaklar.length) { %>
        <div class="belge-listesi">
          <% okunacaklar.forEach(function (belge) { %>
            <a class="belge-satiri" href="/dokumanlar/<%= belge.id %>">
              <span class="belge-kod"><%= belge.kod %></span>
              <span class="belge-satir-govde">
                <strong><%= belge.baslik %></strong>
                <span><%= belge.tur_ad %> · <%= revizyonEtiketi(belge.revizyon) %></span>
              </span>
              <span class="btn btn-kucuk btn-ikincil">Aç ve Oku</span>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bos" style="padding:24px 12px;">
          <h3>Okunacak doküman yok</h3>
          <p>Departmanınıza yeni bir doküman dağıtıldığında burada görünür.</p>
        </div>
      <% } %>
    </div>

    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Yaklaşan Hedefler</h2>
          <p>Aktif işler; hedef tarihi yaklaşanlar ve gecikenler en üstte.</p>
        </div>
        <a class="btn btn-kucuk btn-hayalet" href="/isler?durum=aktif">Tümünü Gör</a>
      </div>
      <% if (yaklasan.length) { %>
        <div class="is-listesi">
          <% yaklasan.forEach(function (is) { %>
            <%- include('partials/is-satiri', { is: is, donus: '/', toplantiGoster: true }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bos" style="padding:24px 12px;">
          <h3>Yaklaşan hedef yok</h3>
          <p>Bir toplantıya iş ekleyip hedef tarih belirlediğinizde burada görünecek.</p>
          <a class="btn btn-ikincil" href="/toplantilar">Toplantı Seç</a>
        </div>
      <% } %>
    </div>
  </div>

  <div class="dikey">
    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Doküman Türleri</h2>
          <p>Görünen dokümanların tür dağılımı.</p>
        </div>
      </div>
      <% const turMap = {}; turSayilari.forEach(function (satir) { turMap[satir.tur_kod] = satir.sayi; }); %>
      <div class="tur-dagilimi">
        <% TUR_KODLARI.forEach(function (kod) { const tur = DOKUMAN_TURLERI[kod]; %>
          <a class="tur-dagilim-satiri" href="/dokumanlar?tur=<%= kod %>">
            <span class="tur-dagilim-ad"><span class="tur-nokta" style="background: <%= tur.renk %>"></span><%= tur.cogul %></span>
            <strong><%= turMap[kod] || 0 %></strong>
          </a>
        <% }) %>
      </div>
    </div>

    <div class="kart" id="bildirimler">
      <div class="kart-bas">
        <div>
          <h2>Bildirimler</h2>
          <p>Onay ve dağıtım bildirimleriniz.</p>
        </div>
        <% if (bildirimler.some(function (b) { return !b.okundu; })) { %>
          <form method="post" action="/bildirimler/oku">
            <button class="btn btn-kucuk btn-hayalet" type="submit">Tümünü okundu yap</button>
          </form>
        <% } %>
      </div>
      <% if (bildirimler.length) { %>
        <div class="bildirim-listesi">
          <% bildirimler.forEach(function (b) { %>
            <a class="bildirim-satiri <%= b.okundu ? '' : 'okunmamis' %>" href="<%= b.baglanti || '/dokumanlar' %>">
              <span class="bildirim-nokta"></span>
              <span class="bildirim-satir-govde">
                <strong><%= b.baslik %></strong>
                <span><%= b.mesaj %></span>
                <small><%= zamanTr(b.olusturma_tarihi) %></small>
              </span>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="metin-kucuk metin-soluk" style="margin:0;">Henüz bildiriminiz yok.</p>
      <% } %>
    </div>

    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Son Dokümanlar</h2>
          <p>Son güncellenen dokümanlar.</p>
        </div>
        <a class="btn btn-kucuk btn-hayalet" href="/dokumanlar">Tümü</a>
      </div>
      <% if (sonDokumanlar.length) { %>
        <div class="belge-listesi">
          <% sonDokumanlar.forEach(function (belge) { %>
            <a class="belge-satiri sade" href="/dokumanlar/<%= belge.id %>">
              <span class="belge-kod"><%= belge.kod %></span>
              <span class="belge-satir-govde">
                <strong><%= kisaMetin(belge.baslik, 48) %></strong>
                <span><%= belge.tur_ad %> · <%= revizyonEtiketi(belge.revizyon) %></span>
              </span>
              <span class="rozet rozet-dok-<%= dokumanDurumSinifi(belge.durum) %>"><%= dokumanDurumEtiketi(belge.durum) %></span>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="metin-kucuk metin-soluk" style="margin:0;">Henüz doküman yok.</p>
      <% } %>
    </div>

    <div class="kart">
      <div class="kart-bas">
        <div>
          <h2>Toplantı Modülü</h2>
          <p>Toplantı ve aksiyon takibi QDMS içinde.</p>
        </div>
        <a class="btn btn-kucuk btn-hayalet" href="/toplantilar">Toplantılar</a>
      </div>
      <div class="mini-istatistik">
        <div><strong><%= sayilar.acik_toplanti %></strong><span>Açık toplantı</span></div>
        <div><strong><%= sayilar.aktif %></strong><span>Aktif iş</span></div>
        <div><strong><%= sayilar.beklemede %></strong><span>Beklemede</span></div>
      </div>
      <% if (sonToplantilar.length) { %>
        <% sonToplantilar.slice(0, 2).forEach(function (toplanti) { %>
          <a class="sorumlu-satir" href="/toplantilar/<%= toplanti.id %>" style="text-decoration:none;color:inherit;">
            <span class="avatar"><%= basHarfler(toplanti.ad) %></span>
            <span class="sorumlu-bilgi">
              <strong><%= toplanti.ad %></strong>
              <span><%= tarihTr(toplanti.tarih) %> · <%= toplanti.is_sayisi %> iş</span>
            </span>
            <span class="rozet rozet-<%= toplanti.durum %>"><%= TOPLANTI_DURUMLARI[toplanti.durum] %></span>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/alt') %>
