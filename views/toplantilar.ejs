<%- include('partials/ust', { aktifSayfa: 'toplantilar' }) %>

<div class="sayfa-bas">
  <div>
    <h1>Toplantılar</h1>
    <p>Toplantı oluşturun; seçtiğiniz toplantının notlarını ve işlerini tek ekranda yönetin.</p>
  </div>
  <div class="sayfa-eylem">
    <a class="btn btn-hayalet" href="/isler">Tüm İşler</a>
    <a class="btn btn-birincil" href="#yeni-toplanti">+ Yeni Toplantı</a>
  </div>
</div>

<%- include('partials/bildirim') %>

<section class="kart" id="yeni-toplanti">
  <div class="kart-bas">
    <div>
      <h2>Yeni Toplantı</h2>
      <p>Bir toplantı adı ve tarihi girin. İşleri toplantı detayından ekleyebilirsiniz.</p>
    </div>
  </div>
  <form method="post" action="/toplantilar" class="form-grid">
    <div class="alan">
      <label for="toplanti-ad">Toplantı adı</label>
      <input class="girdi" type="text" id="toplanti-ad" name="ad" placeholder="Örn. Ürün Yol Haritası" maxlength="150" required>
    </div>
    <div class="alan">
      <label for="toplanti-tarih">Toplantı tarihi</label>
      <input class="girdi" type="date" id="toplanti-tarih" name="tarih" required>
    </div>
    <div class="alan tam">
      <button class="btn btn-birincil" type="submit">Toplantı Oluştur</button>
    </div>
  </form>
</section>

<div class="kart-bas" style="margin-top:26px;">
  <div>
    <h2 style="font-size:17px;margin:0;">Toplantı Listesi</h2>
    <p style="margin:2px 0 0;color:var(--soluk);font-size:12.5px;"><%= toplantilar.length %> toplantı</p>
  </div>
</div>

<% if (toplantilar.length) { %>
  <div class="toplanti-grid">
    <% toplantilar.forEach(function (toplanti) { %>
      <% const ilerleme = toplanti.is_sayisi ? Math.round((toplanti.tamamlandi_sayisi / toplanti.is_sayisi) * 100) : 0; %>
      <a class="toplanti-karti" href="/toplantilar/<%= toplanti.id %>">
        <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;">
          <span class="rozet rozet-<%= toplanti.durum %>"><%= TOPLANTI_DURUMLARI[toplanti.durum] %></span>
          <span class="toplanti-tarih">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="3"></rect>
              <path d="M8 3v4M16 3v4M3 11h18"></path>
            </svg>
            <%= tarihTr(toplanti.tarih) %>
          </span>
        </div>

        <h3><%= toplanti.ad %></h3>

        <div>
          <div class="ilerleme"><span style="width:<%= ilerleme %>%"></span></div>
          <div class="kart-alt">
            <span><%= toplanti.tamamlandi_sayisi %> / <%= toplanti.is_sayisi %> iş tamamlandı</span>
            <span>%<%= ilerleme %></span>
          </div>
        </div>

        <div class="kart-alt" style="border-top:1px solid #f1f5f9;padding-top:12px;">
          <span class="cip"><span class="rozet rozet-aktif"><%= toplanti.aktif_sayisi %></span> Aktif</span>
          <span class="cip"><span class="rozet rozet-beklemede"><%= toplanti.beklemede_sayisi %></span> Beklemede</span>
          <span class="cip"><span class="rozet rozet-tamamlandi"><%= toplanti.tamamlandi_sayisi %></span> Bitti</span>
        </div>
      </a>
    <% }) %>
  </div>
<% } else { %>
  <div class="kart">
    <div class="bos">
      <div class="bos-ikon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="3"></rect>
          <path d="M8 3v4M16 3v4M3 11h18"></path>
        </svg>
      </div>
      <h3>Henüz toplantı yok</h3>
      <p>Yukarıdaki formu kullanarak ilk toplantınızı oluşturun.</p>
      <a class="btn btn-birincil" href="#yeni-toplanti">+ Yeni Toplantı</a>
    </div>
  </div>
<% } %>

<%- include('partials/alt') %>
