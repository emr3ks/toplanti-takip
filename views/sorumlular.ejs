<%- include('partials/ust', { aktifSayfa: 'sorumlular' }) %>

<div class="sayfa-bas">
  <div>
    <h1>Sorumlular</h1>
    <p>İş atamak ve otomatik hatırlatma göndermek için kişilerin adını ve e-posta adresini yönetin.</p>
  </div>
  <div class="sayfa-eylem">
    <a class="btn btn-hayalet" href="/isler">İşleri Gör</a>
  </div>
</div>

<%- include('partials/bildirim') %>

<section class="kart">
  <div class="kart-bas">
    <div>
      <h2>Yeni Sorumlu Ekle</h2>
      <p>Ad ve e-posta adresi zorunludur. E-posta adresi benzersiz olmalıdır.</p>
    </div>
  </div>
  <form method="post" action="/sorumlular" class="form-grid">
    <div class="alan">
      <label for="sorumlu-ad">Ad soyad</label>
      <input class="girdi" type="text" id="sorumlu-ad" name="ad" placeholder="Örn. Elif Kaya" maxlength="120" required>
    </div>
    <div class="alan">
      <label for="sorumlu-email">E-posta adresi</label>
      <input class="girdi" type="email" id="sorumlu-email" name="email" placeholder="elif@ornek.com" maxlength="254" required>
    </div>
    <div class="alan tam">
      <button class="btn btn-birincil" type="submit">Sorumlu Ekle</button>
    </div>
  </form>
</section>

<section class="kart" style="margin-top:18px;">
  <div class="kart-bas">
    <div>
      <h2>Sorumlu Listesi</h2>
      <p><%= sorumlular.length %> kişi kayıtlı.</p>
    </div>
  </div>

  <% if (sorumlular.length) { %>
    <% sorumlular.forEach(function (sorumlu) { %>
      <div class="sorumlu-satir">
        <span class="avatar buyuk"><%= basHarfler(sorumlu.ad) %></span>
        <div class="sorumlu-bilgi">
          <strong><%= sorumlu.ad %></strong>
          <span><%= sorumlu.email %></span>
          <div style="margin-top:5px;display:flex;gap:6px;flex-wrap:wrap;">
            <span class="cip"><%= sorumlu.is_sayisi %> iş</span>
            <% if (sorumlu.aktif_sayisi) { %><span class="rozet rozet-aktif"><%= sorumlu.aktif_sayisi %> aktif</span><% } %>
          </div>
        </div>
        <div class="sorumlu-eylem">
          <details class="duzenle" style="width:auto;">
            <summary>Düzenle</summary>
            <div class="duzenle-form" style="width:290px;">
              <form method="post" action="/sorumlular/<%= sorumlu.id %>" class="dikey">
                <div class="alan">
                  <label for="ad-<%= sorumlu.id %>">Ad soyad</label>
                  <input class="girdi" type="text" id="ad-<%= sorumlu.id %>" name="ad" value="<%= sorumlu.ad %>" maxlength="120" required>
                </div>
                <div class="alan">
                  <label for="email-<%= sorumlu.id %>">E-posta</label>
                  <input class="girdi" type="email" id="email-<%= sorumlu.id %>" name="email" value="<%= sorumlu.email %>" maxlength="254" required>
                </div>
                <button class="btn btn-ikincil" type="submit">Kaydet</button>
              </form>
            </div>
          </details>

          <% if (sorumlu.is_sayisi === 0) { %>
            <form method="post" action="/sorumlular/<%= sorumlu.id %>/sil" data-onay="Bu sorumlu silinecek. Emin misiniz?">
              <button class="btn btn-kucuk btn-tehlike" type="submit">Sil</button>
            </form>
          <% } else { %>
            <span class="metin-kucuk metin-soluk" title="Önce bu sorumluya atanmış işlerin sorumlusunu değiştirin.">Silinemez</span>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="bos">
      <div class="bos-ikon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </div>
      <h3>Henüz sorumlu yok</h3>
      <p>Yukarıdaki formu kullanarak ilk sorumluyu ekleyin.</p>
    </div>
  <% } %>
</section>

<%- include('partials/alt') %>
