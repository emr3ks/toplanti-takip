# Uygulama
PORT=3000
HOST=127.0.0.1

# Veritabanı ve test modu çıktıları (varsayılan: ./data)
# DATA_DIR=./data
# DB_YOLU=./data/toplanti.db
# OUTBOX_DIR=./data/outbox

# E-posta gönderimi
# .env değerleri, arayüzde boş bırakılan alanlar için yedek olarak kullanılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Toplantı Takip

# Toplantı sonu raporunun gönderileceği adres
RAPOR_ALICI=

# Günlük hatırlatma zamanı ve saat dilimi
HATIRLATMA_SAATI=09:00
SAAT_DILIMI=Europe/Istanbul

# 1 yaparsanız e-postalar gönderilmez, data/outbox klasörüne kaydedilir.
# SMTP tanımlı değilse uygulama zaten test modunda çalışır.
MAIL_TEST_MODE=

# Otomatik hatırlatma zamanlayıcısını kapatmak için 1 yapın.
DISABLE_CRON=
