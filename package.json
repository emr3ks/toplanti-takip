{
  "name": "toplanti-takip",
  "version": "1.0.0",
  "private": true,
  "description": "Türkçe arayüzlü, SQLite tabanlı toplantı notları, iş takibi ve otomatik e-posta/hatırlatma uygulaması.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
