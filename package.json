    "turkce"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1"
  }
}
